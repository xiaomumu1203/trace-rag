# Chat Provider (required)
CHAT_PROVIDER=deepseek

# OpenAI settings
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# DeepSeek settings
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# DashScope settings
DASH_SCOPE_API_KEY=
DASH_SCOPE_EMBEDDINGS_MODEL=text-embedding-v4

# Embeddings provider (required)
EMBEDDINGS_PROVIDER=huggingface
OPENAI_EMBEDDINGS_MODEL=text-embedding-ada-002
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MySQL settings (required)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=trace_rag
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=trace_rag

# Redis recent chat-memory cache
REDIS_URL=redis://redis:6379/0
CHAT_MEMORY_TTL_SECONDS=604800
CHAT_MEMORY_MAX_MESSAGES=20

# MinIO settings (required)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_BUCKET_NAME=documents

# Vector store settings (required)
VECTOR_STORE_TYPE=chroma
CHROMA_DB_HOST=chromadb
CHROMA_DB_PORT=8000
QDRANT_URL=http://localhost:6333
QDRANT_PREFER_GRPC=true

# JWT settings (required)
SECRET_KEY=generate_a_long_random_secret_before_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Timezone settings (optional)
TZ=Asia/Shanghai
